# The Local Butcher POS environment variables.
# Copy to .env.local for local development. Never commit real values.
#
# Without these the POS still works, fully offline on each device.
# With them, staff can sign in and the app syncs to Supabase.
# They are built into the app: redeploy after changing them on Vercel.

# Supabase project URL and the public "anon" key (safe for the browser,
# protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Not used by the app yet; reserved for scheduled backups (Phase 7).
SUPABASE_SERVICE_ROLE_KEY=
