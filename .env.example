# The Local Butcher POS environment variables.
# Copy to .env.local for local development. Never commit real values.
#
# Phase 0/1 needs NO environment variables: the POS runs entirely on the
# device. These are reserved for Phase 2 (cloud sync) and are not read yet.

# Supabase project URL and the public "anon" key (safe for the browser,
# protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Needed only for admin tasks such as scheduled backups.
SUPABASE_SERVICE_ROLE_KEY=
